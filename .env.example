# OpenSourceScout — environment template.
# Copy to .env (which is gitignored) and fill in what you want:
#
#     cp .env.example .env
#
# EVERYTHING HERE IS OPTIONAL. With no .env at all, scout.py runs anonymously
# at 60 requests/hr, and `--all` refuses large sweeps rather than dying halfway.
# A real exported env var always overrides this file.

# GitHub API token -> 5000 req/hr instead of 60. Needed to sweep big orgs with --all.
# No scopes required for public repos: https://github.com/settings/tokens
# ("Generate new token (classic)", tick nothing). Leave blank to stay anonymous.
GITHUB_TOKEN=
